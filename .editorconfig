# EditorConfig helps maintain consistent coding styles
# https://editorconfig.org/

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.ts]
indent_size = 2
tab_width = 2

[*.json]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
max_line_length = disable

[*.{js,cjs,mjs}]
indent_size = 2

[package.json]
indent_size = 2

[tsconfig.json]
indent_size = 2

[jest.config.cjs]
indent_size = 2

[eslint.config.mjs]
indent_size = 2
