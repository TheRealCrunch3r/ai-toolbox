{
  "name": "@lmstudio/ai-toolbox",
  "version": "v1.9.15",
  "description": "All-in-one AI agent toolkit plugin for LM Studio — 130+ ready-made local-LLM tool calls: safe file editing & hang-proof codebase search, AST code refactoring, background commands, web research, headless browser automation, Git/GitHub workflows, OCR & image tools, read-only SQLite, document parsing (PDF/DOCX/TXT), sandboxed JS/Python execution, local semantic RAG over PDF/DOCX/XLSX, HTTP client, cross-project memory with self-managing context windows, data visualization & UI generation, task planning, and backup/restore. 747 passing tests across 45 suites · 5 locales · MIT.",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:errorsonly": "node --experimental-vm-modules node_modules/jest/bin/jest.js --silent",
    "test:quiet": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js --silent --no-coverage --forceExit",
    "perf:diagnose": "tsc --extendedDiagnostics",
    "perf:trace": "tsc --generateTrace traceDir",
    "check:circular": "npx madge --circular src/index.ts",
    "decode": "node scripts/decode_context.js"
  },
  "dependencies": {
    "@dqbd/tiktoken": "^1.0.22",
    "@lmstudio/sdk": "^1.5.0",
    "@msgpack/msgpack": "^3.1.3",
    "archiver": "^8.0.0",
    "duck-duck-scrape": "^2.2.7",
    "fflate": "^0.8.3",
    "html-to-text": "^9.0.5",
    "isomorphic-git": "^1.38.6",
    "mammoth": "^1.6.0",
    "markdown-it": "^14.1.0",
    "node-notifier": "^10.0.1",
    "open": "^8.4.2",
    "pdf-parse": "^1.1.1",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "puppeteer": "^24.0.0",
    "ripgrep": "^0.3.1",
    "sharp": "^0.35.3",
    "ssh2": "^1.17.0",
    "tesseract.js": "^7.0.0",
    "unzipper": "^0.12.3",
    "xlsx": "^0.18.5",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.10.0",
    "@types/unzipper": "^0.10.11",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.0.0",
    "jest": "^30.0.0",
    "madge": "^8.0.0",
    "ts-jest": "^29.4.9",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "glob": "^13.0.6",
    "uuid": "^11.0.4"
  },
  "license": "MIT",
  "allowScripts": {
    "puppeteer@24.43.1": true,
    "sharp@0.33.5": true,
    "tesseract.js@7.0.0": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.27.2": true
  }
}
